# Manual finding/report workflow checklist.
#
# Run inside Bywaf:
#   script load file=scripts/manual_finding_report_flow.bywaf
#
# Stages 1-4 use local/controlled targets only. Start the fake Telnet fixture
# in another terminal before running this script:
#   python3 scripts/fake_telnet_service.py --host 127.0.0.1 --port 2323
# Then set script variables before loading:
#   set TARGET=127.0.0.1
#   set PORTS=2323
#   set NMAP_ARGS="-Pn -sT -sV"
#   set REPO_TARGET=http://127.0.0.1:8088
# TARGET accepts one host, DNS name, CIDR, dash range, or comma/space-separated
# list, such as 127.0.0.1, lab.example.test, 192.168.50.0/24, or
# 192.168.50.1-128. PORTS accepts comma-separated ports and ranges, such as
# 22,80,443 or 1-60,80-90.
# Stages 5-6 need a controlled HTTP server; edit the placeholder values and
# remove the leading "# " from those command lines before running them.

# 1. Fresh DB
db new

# 2. Portscanner sanity
network/portscanner host=$TARGET port=$PORTS arguments="$NMAP_ARGS"
event port.open
event name.resolved

# 3. Filtering/provenance
# Choose one IP from the port.open output above and set A to that value.
# Example:
# set A=142.251.16.138
# event port.open host=$A
# job host=$A
# step host=$A
# pipeline host=$A

# 4. Telnet-like finding path
network/portscanner host=$TARGET port=$PORTS arguments="$NMAP_ARGS"
event finding.candidate
report

# 5. HTTP/repo exposure
# Replace <test-host> with a controlled HTTP server exposing /.git/config.
# http/repo_exposure/git_expose_check target=$REPO_TARGET
# event finding.candidate
# report

# 6. Triage
# Run only after report shows findings you intend to mark reviewed.
# report accept all note="confirmed in manual pass"
# report
# event finding.reviewed
